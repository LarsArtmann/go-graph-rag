#!/bin/sh
# Pristine-build guard: the module must build WITHOUT GOEXPERIMENT=jsonv2.
# Dev shells export it machine-wide, which silently masks json/v2 usage that
# breaks pristine toolchains and CI. Install once per clone:
#
#   git config core.hooksPath .githooks
#
echo "pre-push: pristine build (env -u GOEXPERIMENT)..."
env -u GOEXPERIMENT GOTOOLCHAIN=go1.26.7 go build ./... || {
    echo "pre-push: FAILED - tree does not build without GOEXPERIMENT=jsonv2." >&2
    echo "Fix before pushing (usually: import encoding/json, not encoding/json/v2)." >&2
    exit 1
}
echo "pre-push: pristine build ok"
